#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

// for homerow mods

#define LH_POS 0 1 2 3 4 5        13 14 15 16 17 18           28 29 30 31 32 33 34  42 43 44
#define RH_POS 6 7 8 9 10 11 12   19 20 21 22 23 24 25 26 27  35 36 37 38 39 40 41  45 46 47

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        lst: layer_sticky_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LayerStickyTap";
            bindings = <&mo>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            flavor = "balanced";
        };

        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <230>;  // try 200-260
            quick-tap-ms = <175>;     // optional, helps fast repeats
            bindings = <&kp>, <&kp>;
        };

        hmL: hmL {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_L";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <230>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            /* Only become HOLD if the next key is on the other hand */

            hold-trigger-key-positions = <RH_POS>;
            hold-trigger-on-release;
        };

        hmR: hmR {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_R";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <230>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <LH_POS>;
            hold-trigger-on-release;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <30 31>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <32 31>;
        };
    };

    macros {
        last_ime: last_ime {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_release>,
                <&kp LCTRL>,
                <&macro_release>,
                <&kp LGUI>;
        };

        bf_restart: bf_restart {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp Z>,
                <&macro_wait_time 500>,
                <&kp Z>,
                <&macro_wait_time 500>,
                <&kp Z>,
                <&macro_wait_time 10000>,
                <&kp ESCAPE>,
                <&macro_wait_time 500>,
                <&kp SPACE>,
                <&macro_wait_time 1000>,
                <&kp SPACE>,
                <&macro_wait_time 1000>,
                <&kp SPACE>,
                <&macro_wait_time 26000>;

            label = "BF_RESTART";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "COLEMAK"; // layer 0
            bindings = <
&kp TAB        &kp Q        &kp W        &kp F          &kp P         &kp G                            &kp UP                &kp J      &kp L         &kp U          &kp Y        &kp SEMI     &kp BSPC
&mt LCTRL ESC  &hmL LGUI A  &hmL LALT R  &hmL LSHIFT S  &hmL LCTRL T  &kp D                  &kp LEFT  &kp ENTER  &kp RIGHT  &kp H      &hmR RCTRL N  &hmR RSHIFT E  &hmR RALT I  &hmR RGUI O  &kp SQT
&kp LSHIFT     &kp Z        &kp X        &kp C          &kp V         &kp B     &kp SPACE              &kp DOWN              &kp K      &kp M         &kp COMMA      &kp DOT      &kp FSLH     &kp ENTER
                                         &kp LC(F8)     &lst 2 LCTRL  &kp LGUI                                               &kp SPACE  &mo 3         &kp ESC
            >;

            /* &mt LCTRL ESC  &mt LGUI A  &mt LALT R  &mt LSHIFT S  &mt LCTRL T   &kp D                  &kp LEFT  &kp ENTER  &kp RIGHT  &kp H      &mt RCTRL N  &mt RSHIFT E  &mt RALT I  &mt RGUI O  &kp SQT */

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        qwerty_layer {
            display-name = "QWERTY"; // layer 1
            bindings = <
&kp TAB     &kp Q  &kp W  &kp E     &kp R  &kp T                             &kp UP                &kp Y      &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL   &kp A  &kp S  &kp D     &kp F  &kp G                   &kp LEFT  &kp ENTER  &kp RIGHT  &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHIFT  &kp Z  &kp X  &kp C     &kp V  &kp B      &kp SPACE              &kp DOWN              &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ENTER
                          &kp LALT  &mo 2  &kp SPACE                                               &kp SPACE  &mo 3  &kp ESC
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            display-name = "SYMBOL"; // layer 2
            bindings = <
&kp TILDE   &kp EXCL       &kp AT         &kp HASH       &kp DLLR       &kp PRCNT                                &mmv MOVE_UP                     &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR  &kp LC(BSPC)
&kp DEL     &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4             &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp INS    &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE
&caps_word  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &trans                    &mmv MOVE_DOWN                   &kp PIPE   &kp HOME   &kp PG_DN  &kp PG_UP  &kp END   &kp C_PLAY_PAUSE
                                          &kp LGUI       &trans         &kp SPACE                                                                 &last_ime  &mo 4      &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        raise_layer {
            display-name = "NUMBER"; // layer 3
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3    &kp N4   &kp N5                                  &mmv MOVE_UP                     &kp N6             &kp N7     &kp N8     &kp N9    &kp N0     &kp BSPC
&kp DEL    &kp F1  &kp F2  &kp F3    &kp F4   &kp F5                  &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp F6             &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT   &kp BSLH
&kp CAPS   &kp F7  &kp F8  &kp F9    &kp F10  &kp F11   &kp C_MUTE                    &mmv MOVE_DOWN                   &mt F12 BACKSLASH  &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT  &none
                           &kp LALT  &mo 4    &kp LGUI                                                                 &kp SPACE          &trans     &none
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        mod_layer {
            display-name = "FUNTION"; // layer 4
            bindings = <
&studio_unlock  &none           &none         &none            &none   &tog 1                                     &mmv MOVE_UP                     &none           &kp C_NEXT    &none         &kp LPAR       &kp RPAR          &none
&none           &bt BT_CLR_ALL  &bt BT_CLR    &kp PRINTSCREEN  &none   &bf_restart                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp LBRC       &kp RBRC          &none
&sys_reset      &out OUT_USB    &out OUT_BLE  &bootloader      &none   &none        &kp C_MUTE                    &mmv MOVE_DOWN                   &none           &bootloader   &sys_reset    &kp LESS_THAN  &kp GREATER_THAN  &none
                                              &none            &trans  &none                                                                       &none           &trans        &none
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_5 {
            display-name = "Fn5"; // layer 5
            bindings = <
&none  &none  &none  &none  &none  &none                           &mmv MOVE_UP                     &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none                    &mmv MOVE_DOWN                   &none  &none  &none  &none  &none  &none
                     &none  &none  &none                                                            &none  &none  &none
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_6 {
            display-name = "Fn6"; // layer 6
            bindings = <
&none  &none  &none  &none  &none  &none                           &mmv MOVE_UP                     &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none           &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none                    &mmv MOVE_DOWN                   &none  &none  &none  &none  &none  &none
                     &none  &none  &none                                                            &none  &none  &none
            >;

            sensor-bindings = <&scroll_encoder>;
        };
    };
};
